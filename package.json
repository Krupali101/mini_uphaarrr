{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "concurrently --kill-others --raw \"node scripts/dev-api.js\" \"npm run dev --prefix apps/web\"",
		"build": "npm run build --prefix apps/web",
		"seed:catalog": "node scripts/seed-catalog.mjs",
		"start": "concurrently --kill-others --raw",
		"lint": "concurrently --raw \"npm run lint --prefix apps/web\""
	},
	"devDependencies": {
		"concurrently": "^9.1.2"
	},
	"workspaces": [
		"apps/*"
	],
	"dependencies": {
		"dotenv": "^18.0.1",
		"mongoose": "^9.10.1",
		"nodemailer": "^8.0.8"
	}
}
